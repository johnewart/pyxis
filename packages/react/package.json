  },
  "devDependencies": {
    "@pyxis-llm/client": "file:../client",
    "@mantine/core": "^7.15.0",
    "@mantine/hooks": "^7.15.0",
    "@mermaid-js/layout-elk": "^0.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/turndown": "^5.0.5",
